database -open waves -into waves.shm -default
probe -create -shm tb_FSM1.ws tb_FSM1.rst_n tb_FSM1.rd tb_FSM1.go tb_FSM1.ds tb_FSM1.clk
run
run -step
probe -create -shm tb_FSM1.DUT.ws tb_FSM1.DUT.state tb_FSM1.DUT.rst_n tb_FSM1.DUT.rd tb_FSM1.DUT.next tb_FSM1.DUT.go tb_FSM1.DUT.ds tb_FSM1.DUT.clk
run
exit
